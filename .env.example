# Copy to .env (repo root) and fill in. Read by the axum server at startup.

# Google OAuth client (Web application). Authorized redirect URI must be
#   ${PUBLIC_URL}/auth/callback
# e.g. https://shubhanx86.com/auth/callback  (prod)
#      http://localhost:5173/auth/callback   (dev, through the Vite proxy)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public origin the browser sees (no trailing slash). https:// enables Secure cookies.
PUBLIC_URL=https://shubhanx86.com

# Comma-separated Google accounts allowed to unlock the homeserver ship.
ALLOWED_EMAILS=you@gmail.com

# Random string, at least 32 chars. Encrypts session cookies; changing it logs everyone out.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Optional (defaults shown; relative paths resolve from the server's working directory)
# BIND_ADDR=0.0.0.0:8080
# STATIC_DIR=../web/dist
# HOMESERVER_DATA=data/homeserver.json
